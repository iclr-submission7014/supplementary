#!/usr/bin/env python3
"""Check resolved identities, including environment overrides, before commit."""
import subprocess
import sys

expected = 'Anonymous Authors <iclr-submission7014@users.noreply.github.com>'
for role in ('GIT_AUTHOR_IDENT', 'GIT_COMMITTER_IDENT'):
    identity = subprocess.check_output(['git', 'var', role], text=True).strip()
    if identity.rsplit(' ', 2)[0] != expected:
        sys.exit('Commit blocked: ' + role + ' is not the anonymous identity. '
                 'Check repository-local Git config and GIT_AUTHOR/GIT_COMMITTER overrides.')
